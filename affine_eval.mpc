# Private affine evaluation  f(x; (y, r)) = x * y + r,  output only to P0.
# This is Example 2 from the paper (OLE-style functionality).
#
# P0 supplies x; P1 supplies (y, r) with r uniform and independent of y.
# The result is revealed only to P0. Because r is uniform, the output is
# uniform for ANY x, so it reveals nothing about y -- not even whether y = 1.
#
# Key point for the off-key attack: y is input on the MAIN thread (MAC key
# alpha), while x, r, the Beaver triple, and the one-sided-output mask are all
# on the WORKER thread (MAC key alpha+1 under the attack). Unlike Example 1,
# x is nonzero, so x MUST be authenticated under the worker key -- otherwise
# the mask opening epsilon = x - a would fail regardless of y. Inputting x on
# the worker thread achieves this.
#
# Both parties run this exact same program, unmodified.

y = MemValue(sint.get_input_from(1))   # P1's y, on the main thread (key alpha)

def worker():
    x = sint.get_input_from(0)         # P0's x, on the worker thread (alpha+1)
    r = sint.get_input_from(1)         # P1's r, on the worker thread (alpha+1)
    out = x * y.read() + r             # Beaver multiplication under alpha+1
    res = out.reveal_to(0)             # one-sided output: mask known only to P0
    print_ln_to(0, 'x*y+r = %s', res)  # only P0 sees this

tape = program.new_tape(worker)
program.join_tape(program.run_tape(tape, 0))

print_ln('DONE')
